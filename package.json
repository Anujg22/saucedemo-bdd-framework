
{
  "name": "saucedemo-bdd-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "cucumber-js --import \"./steps/**/*.steps.js\" --import \"./support/**/*.js\"",
    "test:smoke": "cucumber-js --import \"./steps/**/*.steps.js\" --import \"./support/**/*.js\" --tags @smoke",
    "test:headed": "cross-env HEADLESS=false cucumber-js --import \"./steps/**/*.steps.js\" --import \"./support/**/*.js\"",
    "test:negative": "cucumber-js --import \"./steps/**/*.steps.js\" --import \"./support/**/*.js\" --tags @negative",
    "test:purchase": "cucumber-js --import \"./steps/**/*.steps.js\" --import \"./support/**/*.js\" --tags @purchase"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.0.0",
    "dotenv": "^16.4.0",
    "pg": "^8.16.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@cucumber/pretty-formatter": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "cross-env": "^7.0.3"
  }
}
